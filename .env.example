# Скопируйте в .env и задайте свои значения:  cp .env.example .env
# deploy/install.sh при первом запуске сам создаёт .env со случайными паролями.

# --- База данных ---
# Образ MariaDB (версия на выбор — ответ куратора). Для строгого соответствия ТЗ: mariadb:10.1
DB_IMAGE=mariadb:11.4
DB_NAME=webreport
DB_USER=webreport
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
# БД видна только приложению. DB_EXPOSE=1 — открыть порт на хосте (см. docker-compose.dbport.yml)
DB_EXPOSE=0
DB_BIND=127.0.0.1
DB_PUBLIC_PORT=3306

# --- Приложение ---
# Порт веб-интерфейса на хосте
APP_PORT=80
# Версия образа приложения (install.sh проставляет сам)
APP_VERSION=latest
# Длинная случайная строка для подписи сессий, например: openssl rand -hex 32.
# Из неё же выводится ключ шифрования пароля почты в БД
# (или задайте отдельный SETTINGS_SECRET). Не меняйте после настройки почты.
JWT_SECRET=
SETTINGS_SECRET=
# Часовой пояс центра: в нём вводятся и хранятся все даты
APP_TZ=Asia/Yekaterinburg
# Первый администратор (создаётся, только если в БД ещё нет пользователей)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin
# Демо-режим: пользователи duty/duty и engineer/engineer, инвентарь из 270 БС,
# 420 аварий за 60 дней и 3 правила уведомлений (только в пустой БД)
SEED_DEMO=false
# Ссылка на заявку в CRM по номеру из поля PW/NTT, {id} заменяется номером
CRM_URL_TEMPLATE=
# Например, для Jira: CRM_URL_TEMPLATE=https://jira.motiv.local/browse/{id}  (PW/NTT вида NTT-63587)
# Время жизни сессии, часов
SESSION_HOURS=12
# Адрес приложения для ссылок в уведомлениях, например https://report.motiv.local
APP_URL=

# --- HTTPS ---
# Встроенный HTTPS включается сам, если в ./certs есть server.crt и server.key
# (свой сертификат или sh deploy/make-cert.sh <имя-сервера>). Порт HTTPS на хосте:
HTTPS_PORT=443
# Если TLS терминируется на балансировщике: адреса балансировщика (или число прокси)
# и COOKIE_SECURE=true
TRUST_PROXY=loopback, linklocal, uniquelocal
COOKIE_SECURE=false

# --- Уведомления: e-mail ---
# Приложение отправляет письма через почтовый сервер компании как обычный клиент
# (адрес, порт, логин, пароль). Удобнее задать это в интерфейсе:
# Администрирование → Уведомления → Подключения — там же проверка подключения.
# Значения ниже — начальные; после сохранения в интерфейсе действуют настройки оттуда.
# Пусто — письма не отправляются, но видны в журнале уведомлений.
SMTP_HOST=
# 587 — STARTTLS, 465 — SSL/TLS (SMTP_SECURE=true), 25 — внутренняя пересылка
SMTP_PORT=25
SMTP_SECURE=false
# Точнее: auto (STARTTLS, если есть), starttls (обязательно), ssl, none (без шифрования)
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Веб отчётность <webreport@motiv.local>
# false — принимать самоподписанный сертификат почтового сервера
SMTP_TLS_VERIFY=true
# Домены, на которые разрешено отправлять (только внутренние адреса). Пусто — домен отправителя
MAIL_ALLOWED_DOMAINS=
