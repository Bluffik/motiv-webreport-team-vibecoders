# Данные для установки на сервер — шаблон.
# Скопируйте в deploy/servers.env и заполните. servers.env в git не попадает (.gitignore).
#   cp deploy/servers.env.example deploy/servers.env
#   sh deploy/remote-deploy.sh all

# ---------------- Версия комплекта
VERSION=1.0.0

# ---------------- SSH
# Ключ для входа на оба сервера (публичная часть — в ~/.ssh/authorized_keys на серверах)
SSH_KEY=~/.ssh/webreport_deploy

# ---------------- Сервер приложения (хостинг в РФ)
APP_HOST=
APP_SSH_USER=root
APP_SSH_PORT=22
# Домен приложения: A-запись → APP_HOST. Пусто — работа по IP с самоподписанным сертификатом
APP_DOMAIN=
# Каталог установки на сервере
APP_DIR=/opt/webreport
# Демо-данные при первой установке (инвентарь, сводка ЦОУ, история за 60 дней)
SEED_DEMO=true

# ---------------- Где собирать образы
# app — прямо на сервере приложения (нужен доступ к Docker Hub);
# local — готовый комплект dist-bundle/webreport-$VERSION.tar.gz (собран GitHub Actions или на машине с Docker)
BUILD_ON=local

# ---------------- Let's Encrypt (необязательно)
LE_EMAIL=

# ---------------- Почтовый сервер (SMTP компании)
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | auto | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Веб отчётность
SMTP_FROM_ADDRESS=
# false — принимать самоподписанный сертификат почтового сервера
SMTP_TLS_VERIFY=true
# Куда отправить проверочное письмо
MAIL_TEST_TO=
# Разрешённые домены получателей (пусто — домен отправителя)
MAIL_ALLOWED_DOMAINS=
